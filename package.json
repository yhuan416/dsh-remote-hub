{
  "name": "dsh-remote-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hub-side DSH host plugin: reverse-proxies multiple dsh web backends under /remotes/<id>/, manages their ssh -L tunnels, resolves launch tokens, and ships an admin UI.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "ssh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-launcher.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhuan416/dsh-remote-hub.git"
  },
  "homepage": "https://github.com/yhuan416/dsh-remote-hub#readme",
  "bugs": {
    "url": "https://github.com/yhuan416/dsh-remote-hub/issues"
  }
}
